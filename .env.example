# Self-host do Wayboo (docker-compose.yml). Copie para .env e ajuste. Guia: docs/self-host.md.

# URL que o celular usa para chegar ao gateway. Vai dentro dos estilos do mapa, então
# precisa ser alcançável pelo aparelho (IP da máquina na rede local ou domínio).
PUBLIC_URL=http://localhost:8080
GATEWAY_PORT=8080

# HTTP expõe o token do aparelho na rede. Para HTTPS com domínio próprio (docs/self-host.md):
# GATEWAY_ADDRESS=wayboo.example.com, GATEWAY_PORT=80, GATEWAY_HTTPS_PORT=443 e PUBLIC_URL=https://...
GATEWAY_ADDRESS=:80
GATEWAY_HTTPS_PORT=8443
# 127.0.0.1 publica o gateway só para um proxy local que termina o TLS.
GATEWAY_BIND=0.0.0.0

# Destino de host.docker.internal na API. O padrão host-gateway serve ao Docker Desktop e ao Docker Engine
# comum. Troque por um IP se o daemon roda sem bridge padrão (bridge=none) ou rootless (docs/self-host.md).
# HOST_GATEWAY=host-gateway

# Extrato OSM (.osm.pbf) usado pelo roteamento e pelo mapa. Trocar a URL refaz os dois.
# Exemplos: https://download.geofabrik.de/south-america/brazil/sudeste-latest.osm.pbf
#           https://download.geofabrik.de/south-america/brazil-latest.osm.pbf
OSM_EXTRACT_URL=https://download.geofabrik.de/europe/andorra-latest.osm.pbf

# Região do índice pronto do Photon (busca). Não vem do extrato: o Photon baixa o próprio índice.
# Para o Brasil, use south-america (~14 GB compactado).
PHOTON_REGION=andorra
PHOTON_MEMORY=1g

# Memória do Planetiler ao gerar os tiles e threads do Valhalla.
PLANETILER_MEMORY=2g
VALHALLA_THREADS=2

# Variáveis da API (opcionais). Comentadas, valem os padrões abaixo. Ver apps/api/src/config.ts.

# Privacidade: horas que o servidor guarda o rastro GPS, os planos e os alertas expirados depois do fim.
# 0 apaga na próxima rodada (ao subir e a cada hora). Valor inválido impede a API de subir. Ver docs/privacidade.md.
# GPS_RETENTION_HOURS=24

# IA do copiloto. Sem AI_PROVIDER, a API escolhe pela chave presente (Anthropic, OpenAI, OpenRouter) ou desliga a IA.
# Valores aceitos: anthropic, openai, ollama, openrouter ou none.
# AI_PROVIDER=ollama
# Padrão claude-opus-5-5 com anthropic; obrigatório com openai, ollama e openrouter.
# AI_MODEL=llama3.1
# Padrão http://localhost:11434/v1 com ollama e https://openrouter.ai/api/v1 com openrouter.
# No Docker, o Ollama da máquina (no Linux, o Ollama precisa escutar fora do 127.0.0.1; ver "Ollama na mesma máquina" em docs/self-host.md):
# AI_BASE_URL=http://host.docker.internal:11434/v1
# Tempo máximo de cada chamada ao modelo, em milissegundos.
# AI_TIMEOUT_MS=15000
# Chaves (sem padrão). ANTHROPIC_AUTH_TOKEN substitui ANTHROPIC_API_KEY. OLLAMA_API_KEY tem padrão "ollama".
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_API_KEY=

# Sugestões de rotina: idade máxima da rota guardada (minutos) e raio (metros) em que ela ainda vale para o pedido.
# SUGGESTION_ROUTE_MAX_AGE_MIN=1440
# SUGGESTION_ROUTE_RADIUS_M=250

# Clima. Sem acesso, o ETA segue sem o fator clima.
# OPEN_METEO_URL=https://api.open-meteo.com
# Origem aceita pelo CORS (uma só). Sem valor, a API aceita qualquer origem.
# CORS_ORIGIN=https://wayboo.example.com
# Nível de log: fatal, error, warn, info, debug ou trace.
# LOG_LEVEL=info
# User-Agent das chamadas ao Valhalla, ao Photon e ao Open-Meteo.
# USER_AGENT=Wayboo/0.1 (+https://github.com/caiorg/wayboo)
# Interface em que a API escuta dentro do contêiner.
# HOST=0.0.0.0

# Requisições a POST /auth/device por IP a cada janela, em minutos, inclusive as inválidas. IPv6 conta por /64.
# 0 desliga o limite.
# AUTH_DEVICE_RATE_LIMIT=30
# AUTH_DEVICE_RATE_WINDOW_MIN=60

# O docker-compose.yml fixa estas e ignora o valor do .env. Os padrões valem para a API fora do Compose.
# PORT=8787
# DB_PATH=wayboo.db
# VALHALLA_URL=https://valhalla1.openstreetmap.de
# PHOTON_URL=https://photon.komoot.io
# Sem MAP_STYLE_URL, o app usa os estilos do OpenFreeMap. MAP_STYLE_DARK_URL tem padrão MAP_STYLE_URL.
# MAP_STYLE_URL=
# MAP_STYLE_DARK_URL=
# Proxies cujo X-Forwarded-For a API aceita: IPs, CIDRs ou loopback/linklocal/uniquelocal, separados por vírgula.
# Sem valor, não confia em ninguém. O Compose fixa uniquelocal, a rede do gateway.
# TRUST_PROXY=
# Pasta dos estilos, fontes e sprites gerados pelo serviço map-assets.
# MAP_DIR=/srv/map
