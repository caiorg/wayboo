{
  "name": "@wayboo/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@maplibre/maplibre-react-native": "^11.5.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@types/geojson": "^7946.0.16",
    "@wayboo/core": "workspace:*",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.14",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-speech": "~58.0.4",
    "expo-status-bar": "~58.0.5",
    "expo-task-manager": "~58.0.14",
    "maplibre-gl": "^6.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "bun run copy-map-worker && expo start --web",
    "typecheck": "tsc --noEmit",
    "copy-map-worker": "node -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});fs.copyFileSync(require.resolve('maplibre-gl/dist/maplibre-gl-worker.mjs'),'public/maplibre-gl-worker.mjs')\"",
    "postinstall": "bun run copy-map-worker",
    "test": "vitest run"
  },
  "private": true,
